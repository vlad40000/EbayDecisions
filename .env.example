# ─── Database (required) ──────────────────────────────────────────────────────
# Neon pooled connection string. Use the pooled (-pooler) endpoint for the app.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── Auth (required) ──────────────────────────────────────────────────────────
APP_PASSWORD="change-me-to-something-long"
# Independent HMAC key for expiring signed sessions. Generate: openssl rand -base64 48
AUTH_SECRET="change-me-openssl-rand-base64-48"
# SESSION_DAYS="30"

# ─── Integration API (optional) ───────────────────────────────────────────────
# Bearer key for service callers (Parts Engine) of /api/integrations/*.
# Sent as: Authorization: Bearer <INTEGRATION_API_KEY>
# Unset or shorter than 16 characters = the integration API answers 503.
# Generate: openssl rand -base64 48
# INTEGRATION_API_KEY="change-me-openssl-rand-base64-48"

# ─── eBay API (optional, off by default) ──────────────────────────────────────
# The production workflow is fully usable without eBay API credentials:
# Product Research values can be entered manually and saved explicitly.
#
# Manual-only by default. No eBay API call is made unless
# EBAY_AUTOMATED_RESEARCH_ENABLED is exactly "true"; unset, "false", "TRUE",
# "1" and every other value mean manual-only. In manual-only mode Tracker
# Capture Active is hidden, POST /api/integrations/research and
# GET /api/ebay/preview/[mpn] and /api/ebay/research/[mpn] answer 503, and
# POST /api/ebay/sync and GET /api/cron/sync are skipped, each before
# contacting eBay or writing a snapshot. MPN-only eBay links, SAVE RESEARCH,
# part registration and market-facts reads are unaffected. Credentials alone
# never enable automated research.
# EBAY_AUTOMATED_RESEARCH_ENABLED="false"
#
# Future/controlled adapter work should be user-initiated for one MPN or a
# deliberately selected working set. There is no scheduled catalogue-wide
# research cron in vercel.json. GET /api/cron/sync additionally requires
# EBAY_CRON_ENABLED="true" and a CRON_SECRET bearer token.
# EBAY_CRON_ENABLED="false"
# CRON_SECRET="change-me-openssl-rand-base64-48"
#
# EBAY_CLIENT_ID="YourApp-PRD-xxxxxxxxx-xxxxxxxx"
# EBAY_CLIENT_SECRET="PRD-xxxxxxxxxxxx-xxxx-xxxx-xxxx-xxxx"
# EBAY_ENV="production"
# EBAY_MARKETPLACE_ID="EBAY_US"
#
# browse   = active used listings / asking prices / point-in-time competition
# insights = completed sales aggregates; restricted eBay access is required
# auto     = probe Insights, then fall back to Browse
# EBAY_ADAPTER and EBAY_SYNC_LIMIT apply to the catalogue sync only.
# With automated research enabled, POST /api/integrations/research tries Browse
# and Insights separately for at most 20 registered MPNs; missing Insights
# access is reported, not faked.
# EBAY_ADAPTER="auto"
# EBAY_SCOPE_BROWSE="https://api.ebay.com/oauth/api_scope"
# EBAY_SCOPE_INSIGHTS="https://api.ebay.com/oauth/api_scope/buy.marketplace.insights"
# EBAY_SYNC_LIMIT="20"
