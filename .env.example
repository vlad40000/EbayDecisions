# ─── Database (required) ──────────────────────────────────────────────────────
# Neon pooled connection string. Neon Console → your project → Connect →
# copy the "Pooled connection" string (it contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── Auth (required) ──────────────────────────────────────────────────────────
# The single shared password used to sign in.
APP_PASSWORD="change-me-to-something-long"

# Secret used to sign the session cookie. Generate one with:
#   openssl rand -base64 48
# Changing this invalidates every existing session.
AUTH_SECRET="change-me-openssl-rand-base64-48"

# Optional: session lifetime in days (default 30).
# SESSION_DAYS="30"

# ─── Cron (required for scheduled eBay sync on Vercel) ────────────────────────
# Vercel sends this as a Bearer token on scheduled invocations of
# /api/cron/sync. Generate with: openssl rand -hex 32
# Set it in Vercel project settings; the cron route rejects calls without it.
CRON_SECRET="change-me-openssl-rand-hex-32"

# ─── eBay API (optional — the app works fully without these) ──────────────────
# Without credentials, every market number is entered by hand in the Tracker.
# With them, the Sync button and the nightly cron pull market data for you.
#
# Get keys at https://developer.ebay.com → My Account → Application Keys.
# EBAY_CLIENT_ID="YourApp-PRD-xxxxxxxxx-xxxxxxxx"
# EBAY_CLIENT_SECRET="PRD-xxxxxxxxxxxx-xxxx-xxxx-xxxx-xxxx"

# "production" (default) or "sandbox".
# EBAY_ENV="production"

# Marketplace to search. Default EBAY_US.
# EBAY_MARKETPLACE_ID="EBAY_US"

# Which adapter to use:
#   "browse"   — active listings only (asking prices). Works with default keys.
#   "insights" — real sold comps. Requires eBay to approve the
#                buy.marketplace.insights scope for your app; covers 90 days.
#   "auto"     — try insights, fall back to browse. (default)
# EBAY_ADAPTER="auto"

# Override the OAuth scopes if eBay assigns your app different ones.
# EBAY_SCOPE_BROWSE="https://api.ebay.com/oauth/api_scope"
# EBAY_SCOPE_INSIGHTS="https://api.ebay.com/oauth/api_scope/buy.marketplace.insights"

# Safety valve: max parts touched per sync run. Default 100.
# EBAY_SYNC_LIMIT="100"
